cabal-version:      3.0
name:               python-dep-checker
version:            0.1.0.0
synopsis:           List Python files imported by a notebook or Python entrypoint
description:
  Reads one Jupyter notebook (.ipynb) or Python file (.py), extracts the
  import statements, resolves them against local project roots, and follows
  imports of the discovered Python files. The result is a sorted list of
  local Python files that the entrypoint depends on.
license:            MIT
license-file:       LICENSE
author:             takanotume24
maintainer:         takanotume24
build-type:         Simple
extra-source-files: README.md
                    structure-lint.json
                    Dockerfile
                    .dockerignore
                    docs/windows-podman.md
                    scripts/podman-build.ps1
                    scripts/podman-build.cmd
                    scripts/podman-run.ps1
                    scripts/podman-run.cmd
                    examples/README.md
                    examples/notebook.ipynb
                    examples/script.py
                    examples/demo_pkg/__init__.py
                    examples/demo_pkg/core.py
                    examples/demo_pkg/sibling.py
                    examples/demo_pkg/utils/__init__.py
                    examples/demo_pkg/utils/helpers.py

common common-settings
  default-language: GHC2024
  ghc-options:      -Wall

library
  hs-source-dirs:   src
  exposed-modules:
      PythonDepChecker.CollectDependencies
      PythonDepChecker.ExtractImports
      PythonDepChecker.ImportRef
      PythonDepChecker.LogicalLines
      PythonDepChecker.Options
      PythonDepChecker.ParseArgs
      PythonDepChecker.ParseImportLine
      PythonDepChecker.PrintUsage
      PythonDepChecker.ReadEntrySources
      PythonDepChecker.ReadNotebookSources
      PythonDepChecker.ReadPythonFile
      PythonDepChecker.ResolveImport
      PythonDepChecker.Run
      PythonDepChecker.StripPythonComments
      PythonDepChecker.StripPythonStrings
      PythonDepChecker.ToDisplayPath
  build-depends:
      base >=4.19 && <5
    , aeson >=2.1
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , vector
  default-language: GHC2024
  ghc-options:      -Wall

executable python-dep-checker
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      base >=4.19 && <5
    , python-dep-checker
  default-language: GHC2024
  ghc-options:      -Wall

test-suite python-dep-checker-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
      Test.PythonDepChecker.CollectDependenciesSpec
      Test.PythonDepChecker.ExamplesSpec
      Test.PythonDepChecker.ExtractImportsSpec
      Test.PythonDepChecker.LogicalLinesSpec
      Test.PythonDepChecker.ParseArgsSpec
      Test.PythonDepChecker.ReadEntrySourcesSpec
      Test.PythonDepChecker.ReadNotebookSourcesSpec
      Test.PythonDepChecker.ReadPythonFileSpec
      Test.PythonDepChecker.ResolveImportSpec
  build-depends:
      base >=4.19 && <5
    , aeson
    , bytestring
    , directory
    , filepath
    , hspec >=2.7 && <3
    , python-dep-checker
    , temporary
    , text
  build-tool-depends:
      hspec-discover:hspec-discover
  default-language: GHC2024
  ghc-options:      -Wall
